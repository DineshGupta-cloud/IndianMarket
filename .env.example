# Copy to ".env" and fill in. Never commit .env to GitHub.

# Optional LLM (Groq free tier: https://console.groq.com/)
GROQ_API_KEY=

# Optional Telegram alerts
# 1. Talk to @BotFather on Telegram → create bot → copy token
# 2. Start a chat with your bot, then get chat id (e.g. @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM overrides
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
