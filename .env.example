# Easiest setup: copy this file to ".env" and paste your key.
# .env is gitignored — it will NOT be uploaded to GitHub.
#
# 1. Get free key: https://console.groq.com/
# 2. Copy this file:  copy .env.example .env   (Windows)
#                     cp .env.example .env     (Mac/Linux)
# 3. Edit .env and put your key on the line below:

GROQ_API_KEY=

# Optional:
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
